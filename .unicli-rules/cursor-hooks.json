{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/code_location_guard.py",
        "matcher": "Write|Edit",
        "failClosed": true,
        "timeout": 20
      },
      {
        "command": ".cursor/hooks/generated_file_guard.py",
        "matcher": "Write|Edit",
        "failClosed": true,
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/plan_checkbox_tracker.py",
        "matcher": "Write|Edit",
        "timeout": 20
      },
      {
        "command": ".cursor/hooks/auto_sync.py",
        "matcher": "Write|Edit",
        "timeout": 30
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/pre_skill_sync.py",
        "matcher": "Read|TabRead",
        "timeout": 120,
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/shell_sensitive_file_guard.py",
        "matcher": "plan\\.md|aidlc-state\\.md|audit\\.md|state\\.md|git\\s+push|git\\s+merge|gh\\s+pr\\s+create",
        "failClosed": true,
        "timeout": 20
      }
    ]
  }
}
