{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/hub/hooks/pre_tool_use.py\"'",
        "matcher": "*",
        "failClosed": false,
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/hub/hooks/post_tool_use.py\"'",
        "matcher": "*",
        "failClosed": false,
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/hub/hooks/before_shell_execution.py\"'",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/hub/hooks/before_mcp_execution.py\"'",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/hub/hooks/stop.py\"'",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/hub/hooks/post_tool_use.py\"'",
        "failClosed": false,
        "timeout": 10
      }
    ]
  }
}
