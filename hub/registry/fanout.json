{
  "schema_version": 1,
  "agents": {
    "source": "hub/agents",
    "orphan_policy": "delete_unproduced",
    "targets": {
      "claude": ".claude/agents",
      "cursor": ".cursor/agents",
      "codex": ".codex/agents"
    }
  },
  "skills": {
    "source": "hub/skills",
    "orphan_policy": "delete_unproduced",
    "targets": {
      "claude": ".claude/skills",
      "cursor": ".cursor/skills",
      "antigravity": ".agents/skills",
      "kiro": ".kiro/steering",
      "codex": ".codex/skills"
    }
  },
  "static_copies": {
    "kiro_steering": {
      "source": "hub/kiro-steering",
      "target": ".kiro/steering",
      "orphan_policy": "delete_unproduced",
      "ignore_stale_globs": ["skill-*.md", "01-project-context.md", "03-memory.md"]
    }
  },
  "mcp": {
    "source": "hub/mcp-servers.json",
    "targets": {
      "claude": {
        "path": ".mcp.json",
        "format": "json"
      },
      "cursor": {
        "path": ".cursor/mcp.json",
        "format": "json"
      },
      "antigravity": {
        "path": ".agents/mcp_config.json",
        "format": "antigravity_json"
      },
      "kiro": {
        "path": ".kiro/settings/mcp.json",
        "format": "json"
      },
      "codex": {
        "path": ".codex/config.toml",
        "format": "toml"
      }
    }
  }
}
