{
  "schema_version": 1,
  "commands": {
    "before_tool": {
      "script": "hub/hooks/pre_tool_use.py",
      "timeout": 20
    },
    "after_tool": {
      "script": "hub/hooks/post_tool_use.py",
      "timeout": 30
    },
    "session_start": {
      "script": "hub/hooks/session_start.py",
      "timeout": 10
    },
    "stop": {
      "script": "hub/hooks/stop.py",
      "timeout": 10
    },
    "before_shell": {
      "script": "hub/hooks/before_shell_execution.py",
      "timeout": 10
    },
    "before_mcp": {
      "script": "hub/hooks/before_mcp_execution.py",
      "timeout": 10
    },
    "after_agent_response": {
      "script": "hub/hooks/post_tool_use.py",
      "timeout": 10
    }
  },
  "targets": {
    "claude": {
      "path": ".claude/settings.json",
      "format": "claude",
      "events": {
        "before_tool": "PreToolUse",
        "after_tool": "PostToolUse",
        "session_start": "SessionStart",
        "stop": "Stop"
      }
    },
    "cursor": {
      "path": ".cursor/hooks.json",
      "format": "cursor",
      "version": 1,
      "fail_closed": false,
      "events": {
        "before_tool": "preToolUse",
        "after_tool": "postToolUse",
        "before_shell": "beforeShellExecution",
        "before_mcp": "beforeMCPExecution",
        "stop": "stop",
        "after_agent_response": "afterAgentResponse"
      }
    },
    "antigravity": {
      "path": ".agents/settings.json",
      "format": "claude",
      "events": {
        "before_tool": "BeforeTool",
        "after_tool": "AfterTool",
        "session_start": "SessionStart"
      },
      "unsupported_events": [
        "stop",
        "before_shell",
        "before_mcp",
        "after_agent_response"
      ]
    },
    "grok": {
      "path": ".grok/hooks/unicli-hub.json",
      "format": "claude",
      "events": {
        "before_tool": "PreToolUse",
        "after_tool": "PostToolUse",
        "session_start": "SessionStart",
        "stop": "Stop"
      },
      "unsupported_events": [
        "before_shell",
        "before_mcp",
        "after_agent_response"
      ]
    },
    "kiro": {
      "path": ".kiro/hooks/unicli-hub.json",
      "format": "kiro",
      "events": {
        "before_tool": "PreToolUse",
        "after_tool": "PostToolUse",
        "session_start": "SessionStart",
        "stop": "Stop"
      },
      "unsupported_events": [
        "before_shell",
        "before_mcp",
        "after_agent_response"
      ]
    }
  }
}
