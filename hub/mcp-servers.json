{
  "_comment": [
    "unicli-hub MCP 서버 원장 (Single Source of Truth)",
    "",
    "【비밀키 관리 원칙】",
    "  - env 블록에 비밀키를 직접 작성하지 않는다.",
    "  - MCP 서버 프로세스는 부모(AI CLI) 프로세스의 환경변수를 자동 상속한다.",
    "  - 환경변수는 ~/.zshrc 또는 ~/.env.local 에만 설정한다.",
    "",
    "【예외: args 에 변수가 필요한 경우】",
    "  - JSON args 배열은 쉘 확장이 없으므로 ${VAR} 치환이 불가하다.",
    "  - 이 경우 ~/.gemini/scripts/ 아래 wrapper script 를 만들고",
    "    command 를 /bin/zsh, args 를 [\"-l\",\"-c\",\"exec wrapper.sh\"] 로 설정한다.",
    "  - wrapper script 는 zsh login shell 로 실행되어 ~/.zshrc 를 로드한다.",
    "",
    "【sync 대상 파일】 (hub/sync.sh 로 자동 생성)",
    "  .agents/mcp_config.json               ← project-level Antigravity/agy",
    "  .cursor/mcp.json                      ← Cursor",
    "  .vscode/mcp.json                      ← VS Code / Kiro",
    "  .mcp.json                             ← Claude Code (project root)",
    "  .agents/mcp_config.json               ← legacy / other agents",
    "",
    "【per-CLI 분기】",
    "  - _overrides: { cli_name: { ...patch } }  — 특정 CLI 에만 다른 값 적용",
    "  - _targets: [\"claude\", \"cursor\"]          — 명시 CLI 에만 포함 (기본은 모두)",
    "  - _comment, _overrides, _targets 키는 fanout 출력에서 자동 제거됨"
  ],
  "mcpServers": {
    "tavily": {
      "_comment": "args에 Bearer 토큰이 필요 → wrapper script 사용. TAVILY_API_KEY는 ~/.zshrc 에서 로드. wrapper script 표준 위치: ~/.config/mcp/tavily-mcp.sh (현재 ~/.gemini/scripts/에 있으면 이동 권장)",
      "command": "/bin/zsh",
      "args": [
        "-l",
        "-c",
        "exec /Users/1111207/.gemini/scripts/tavily-mcp.sh"
      ],
      "env": {}
    },
    "aws-core": {
      "command": "uvx",
      "args": [
        "awslabs.core-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-docs": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-iam": {
      "_comment": "AWS_PROFILE, AWS_REGION 은 ~/.zshrc 에서 상속",
      "command": "uvx",
      "args": [
        "awslabs.iam-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-northeast-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-iac": {
      "_comment": "AWS_PROFILE 은 ~/.zshrc 에서 상속",
      "command": "uvx",
      "args": [
        "awslabs.aws-iac-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-northeast-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-eks": {
      "_comment": "AWS_PROFILE 은 ~/.zshrc 에서 상속",
      "command": "uvx",
      "args": [
        "awslabs.eks-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-northeast-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-cloudwatch": {
      "_comment": "AWS_PROFILE 은 ~/.zshrc 에서 상속",
      "command": "uvx",
      "args": [
        "awslabs.cloudwatch-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-northeast-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--isolated"
      ],
      "env": {
        "PLAYWRIGHT_MCP_ISOLATED": "true"
      }
    },
    "mcp-atlassian": {
      "_comment": "JIRA_URL, JIRA_PERSONAL_TOKEN, CONFLUENCE_URL, CONFLUENCE_PERSONAL_TOKEN 은 ~/.zshrc 에서 상속",
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {}
    },
    "atom-tmf-kb-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/Users/1111207/atom-tmf-kb-mcp",
        "python",
        "-m",
        "tmf_kb_mcp"
      ],
      "env": {},
      "_comment": "Project-specific TMF KB. Remove or update the --directory path for your project.",
      "_targets": [
        "claude",
        "cursor",
        "codex"
      ]
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=claude-code",
        "--project-from-cwd"
      ],
      "env": {},
      "_overrides": {
        "gemini": {
          "args": [
            "start-mcp-server",
            "--context=ide-assistant",
            "--project-from-cwd"
          ]
        },
        "cursor": {
          "args": [
            "start-mcp-server",
            "--context=ide-assistant",
            "--project-from-cwd"
          ]
        },
        "antigravity": {
          "args": [
            "start-mcp-server",
            "--context=ide-assistant",
            "--project-from-cwd"
          ]
        }
      }
    },
    "gitlab": {
      "_comment": "GITLAB_PERSONAL_ACCESS_TOKEN, GITLAB_API_URL 은 ~/.zshrc 에서 상속",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gitlab"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@context7/mcp-server@latest"
      ],
      "env": {}
    }
  }
}
