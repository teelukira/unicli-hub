{
  "_comment": [
    "unicli-hub MCP 서버 원장 (Single Source of Truth)",
    "",
    "【비밀키 관리 원칙】",
    "  - env 블록에 비밀키를 직접 작성하지 않는다.",
    "  - MCP 서버 프로세스는 부모(AI CLI) 프로세스의 환경변수를 자동 상속한다.",
    "  - 환경변수는 ~/.zshrc 또는 .env.local 에만 설정한다.",
    "",
    "【Wrapper Script 패턴 (권장)】",
    "  - 토큰이 필요한 MCP 서버는 ./scripts/mcp/*-wrapper.sh 로 감싼다.",
    "  - wrapper는 .env/.env.local을 로드하고 필수 변수를 검증한 후 exec.",
    "  - 이렇게 하면 생성된 MCP config에 시크릿이 노출되지 않는다.",
    "",
    "【sync 대상 파일】 (sync.sh 로 자동 생성)",
    "  .mcp.json                             ← Claude Code (project root)",
    "  .cursor/mcp.json                      ← Cursor",
    "  .kiro/settings/mcp.json               ← Kiro",
    "  .agents/mcp_config.json               ← Antigravity/agy",
    "  .codex/config.toml                    ← OpenAI Codex",
    "",
    "【per-CLI 분기】",
    "  - _overrides: { cli_name: { ...patch } }  — 특정 CLI 에만 다른 값 적용",
    "  - _targets: [\"claude\", \"cursor\"]          — 명시 CLI 에만 포함 (기본은 모두)",
    "  - _comment, _overrides, _targets 키는 fanout 출력에서 자동 제거됨"
  ],
  "mcpServers": {
    "tavily": {
      "_comment": "TAVILY_API_KEY는 ~/.zshrc 또는 .env.local에서 export로 로드. zsh login shell에서 직접 실행",
      "command": "/bin/zsh",
      "args": [
        "-l",
        "-c",
        "exec npx -y tavily-mcp@latest"
      ],
      "env": {}
    },
    "aws-docs": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-iac": {
      "_comment": "AWS_PROFILE 은 ~/.zshrc 에서 상속",
      "command": "uvx",
      "args": [
        "awslabs.aws-iac-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-northeast-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-cloudwatch": {
      "_comment": "AWS_PROFILE 은 ~/.zshrc 에서 상속",
      "command": "uvx",
      "args": [
        "awslabs.cloudwatch-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-northeast-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--isolated"
      ],
      "env": {
        "PLAYWRIGHT_MCP_ISOLATED": "true"
      }
    },
    "mcp-atlassian": {
      "_comment": "Wrapper loads .env/.env.local at runtime without rendering secrets into generated MCP config.",
      "command": "/bin/bash",
      "args": [
        "./scripts/mcp/mcp-atlassian-wrapper.sh"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "FASTMCP_SHOW_CLI_BANNER": "false",
        "FASTMCP_CHECK_FOR_UPDATES": "off",
        "TOOLSETS": "all"
      }
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=claude-code",
        "--project-from-cwd"
      ],
      "env": {},
      "_overrides": {
        "gemini": {
          "args": [
            "start-mcp-server",
            "--context=ide-assistant",
            "--project-from-cwd"
          ]
        },
        "cursor": {
          "args": [
            "start-mcp-server",
            "--context=ide-assistant",
            "--project-from-cwd"
          ]
        },
        "antigravity": {
          "args": [
            "start-mcp-server",
            "--context=ide-assistant",
            "--project-from-cwd"
          ]
        }
      }
    },
    "gitlab": {
      "_comment": "Wrapper loads .env/.env.local at runtime without rendering GitLab secrets into generated MCP config.",
      "command": "/bin/bash",
      "args": [
        "./scripts/mcp/gitlab-wrapper.sh"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    },
    "context7": {
      "_comment": "Wrapper loads optional CONTEXT7_API_KEY from .env/.env.local.",
      "command": "/bin/bash",
      "args": [
        "./scripts/mcp/context7-wrapper.sh"
      ],
      "env": {}
    }
  }
}
