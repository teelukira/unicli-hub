{
  "mcpServers": {
    "tavily": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel)\" || exit $?; exec \"$root/scripts/mcp/run-with-env.sh\" \"$@\"",
        "unicli-hub-mcp",
        "/bin/zsh",
        "-l",
        "-c",
        "exec npx -y tavily-mcp@latest"
      ],
      "env": {}
    },
    "aws-docs": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel)\" || exit $?; exec \"$root/scripts/mcp/run-with-env.sh\" \"$@\"",
        "unicli-hub-mcp",
        "uvx",
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-iac": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel)\" || exit $?; exec \"$root/scripts/mcp/run-with-env.sh\" \"$@\"",
        "unicli-hub-mcp",
        "uvx",
        "awslabs.aws-iac-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-northeast-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-cloudwatch": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel)\" || exit $?; exec \"$root/scripts/mcp/run-with-env.sh\" \"$@\"",
        "unicli-hub-mcp",
        "uvx",
        "awslabs.cloudwatch-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "ap-northeast-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "playwright": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel)\" || exit $?; exec \"$root/scripts/mcp/run-with-env.sh\" \"$@\"",
        "unicli-hub-mcp",
        "npx",
        "@playwright/mcp@latest",
        "--isolated"
      ],
      "env": {
        "PLAYWRIGHT_MCP_ISOLATED": "true"
      }
    },
    "mcp-atlassian": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel)\" || exit $?; exec \"$root/scripts/mcp/run-with-env.sh\" \"$@\"",
        "unicli-hub-mcp",
        "scripts/mcp/mcp-atlassian-wrapper.sh"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "FASTMCP_SHOW_CLI_BANNER": "false",
        "FASTMCP_CHECK_FOR_UPDATES": "off",
        "TOOLSETS": "all"
      }
    },
    "serena": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel)\" || exit $?; exec \"$root/scripts/mcp/run-with-env.sh\" \"$@\"",
        "unicli-hub-mcp",
        "serena",
        "start-mcp-server",
        "--context=claude-code",
        "--project-from-cwd"
      ],
      "env": {}
    },
    "gitlab": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel)\" || exit $?; exec \"$root/scripts/mcp/run-with-env.sh\" \"$@\"",
        "unicli-hub-mcp",
        "scripts/mcp/gitlab-wrapper.sh"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    },
    "context7": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "root=\"$(git rev-parse --show-toplevel)\" || exit $?; exec \"$root/scripts/mcp/run-with-env.sh\" \"$@\"",
        "unicli-hub-mcp",
        "scripts/mcp/context7-wrapper.sh"
      ],
      "env": {}
    }
  }
}
